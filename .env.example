# ============================================================
# docker-compose (postgres + pgadmin)
# ============================================================
POSTGRES_USER=nox_user
POSTGRES_PASSWORD=nox_password
POSTGRES_DB=nox_observer
POSTGRES_PORT=5432

# DATABASE_URL is used by external tooling (psql, sqlx-cli) from the host machine.
DATABASE_URL=postgres://nox_user:nox_password@localhost:5432/nox_observer

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

NOX_OBSERVER_PORT=9000

# ============================================================
# nox-observer application (consumed when running inside docker-compose)
# Inside the compose network, the DB host is the service name `postgres`, not `localhost`.
# Bind to 0.0.0.0 so the container's port is reachable from the host.
#
# Convention: uncommented = required or non-default override; commented = optional
# (the code's default applies; the line is here for discoverability only).
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
NOX_OBSERVER_SERVER__HOST=0.0.0.0
NOX_OBSERVER_SERVER__PORT=9000

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
NOX_OBSERVER_DATABASE__URL=postgres://nox_user:nox_password@postgres:5432/nox_observer
# NOX_OBSERVER_DATABASE__MAX_CONNECTIONS=5

# ------------------------------------------------------------
# Database TLS for the Postgres connection. When enabled the client uses
# sslmode=require: the connection is encrypted but the server certificate is not
# verified (the database sits on a trusted private network). There is no client
# certificate; the client authenticates with its password. TLS defaults to off,
# which matches the plaintext local docker-compose Postgres. In production set
# NOX_OBSERVER_DATABASE__TLS_ENABLED=true.
# ------------------------------------------------------------
NOX_OBSERVER_DATABASE__TLS_ENABLED=false

# ------------------------------------------------------------
# Subgraph poller — one URL per chain. Add more `__CHAINS__<chain_id>__URL=`
# lines to enable multichain indexing; each chain gets its own poller task and
# persisted cursor in the `subgraph_poller_state` table.
# ------------------------------------------------------------
NOX_OBSERVER_SUBGRAPH__CHAINS__421614=https://thegraph.arbitrum-sepolia-testnet.noxprotocol.io/api/subgraphs/id/BjQAX2HpmsSAzURJimKDhjZZnkSJtaczA8RPumggrStb
# NOX_OBSERVER_SUBGRAPH__CHAINS__1=https://thegraph.mainnet.example.com/...
# NOX_OBSERVER_SUBGRAPH__POLL_INTERVAL_SECONDS=10
# NOX_OBSERVER_SUBGRAPH__BATCH_SIZE=1000

# ------------------------------------------------------------
# NATS consumer — comma-separated URLs. TLS off here; flip ENABLED=true and
# fill CA/CERT/KEY (PEM contents or paths) to enable.
# ------------------------------------------------------------
NOX_OBSERVER_NATS__URLS=nats://<your-nats-host>:4222
NOX_OBSERVER_NATS__TLS__ENABLED=false
# NOX_OBSERVER_NATS__TLS__CA=
# NOX_OBSERVER_NATS__TLS__CERT=
# NOX_OBSERVER_NATS__TLS__KEY=
# NOX_OBSERVER_NATS__STREAM_NAME=nox_ingestor
# NOX_OBSERVER_NATS__CONSUMER_NAME=nox_observer_consumer
# NOX_OBSERVER_NATS__CONSUMER_MAX_DELIVER=10
# NOX_OBSERVER_NATS__MAX_ACK_PENDING=10
# NOX_OBSERVER_NATS__MAX_BATCH=10

# ------------------------------------------------------------
# S3 resolver — one bucket per chain. Add more `__CHAINS__<chain_id>__...`
# blocks to enable resolution on additional chains.
# ------------------------------------------------------------
NOX_OBSERVER_S3__CHAINS__421614__BUCKET=<your-bucket>
NOX_OBSERVER_S3__CHAINS__421614__ACCESS_KEY=<your-access-key>
NOX_OBSERVER_S3__CHAINS__421614__SECRET_KEY=<your-secret-key>
NOX_OBSERVER_S3__CHAINS__421614__REGION=<your-region>
# NOX_OBSERVER_S3__CHAINS__421614__ENDPOINT_URL=https://minio.example.com
# NOX_OBSERVER_S3__CHAINS__421614__TIMEOUT=30
# NOX_OBSERVER_S3__POLL_INTERVAL_SECONDS=10
# NOX_OBSERVER_S3__BATCH_SIZE=1000
# NOX_OBSERVER_S3__MAX_CONCURRENT_REQUESTS=1000
