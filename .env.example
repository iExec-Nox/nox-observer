# ============================================================
# docker-compose (postgres + pgadmin)
# ============================================================
POSTGRES_USER=nox_user
POSTGRES_PASSWORD=nox_password
POSTGRES_DB=nox_observer
POSTGRES_PORT=5432

# DATABASE_URL is used by external tooling (psql, sqlx-cli) from the host machine.
DATABASE_URL=postgres://nox_user:nox_password@localhost:5432/nox_observer

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

NOX_OBSERVER_PORT=9000

# ============================================================
# nox-observer application (consumed when running inside docker-compose)
# Inside the compose network, the DB host is the service name `postgres`, not `localhost`.
# Bind to 0.0.0.0 so the container's port is reachable from the host.
# ============================================================
NOX_OBSERVER_SERVER__HOST=0.0.0.0
NOX_OBSERVER_SERVER__PORT=9000

NOX_OBSERVER_DATABASE__URL=postgres://nox_user:nox_password@postgres:5432/nox_observer
NOX_OBSERVER_DATABASE__MAX_CONNECTIONS=5

NOX_OBSERVER_SUBGRAPH__URL=https://thegraph.arbitrum-sepolia-testnet.noxprotocol.io/api/subgraphs/id/BjQAX2HpmsSAzURJimKDhjZZnkSJtaczA8RPumggrStb
NOX_OBSERVER_SUBGRAPH__CHAIN_ID=421614
NOX_OBSERVER_SUBGRAPH__POLL_INTERVAL_SECONDS=10
NOX_OBSERVER_SUBGRAPH__BATCH_SIZE=100
